{
  "name": "smart-logistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered logistics intelligence platform (TypeScript, AWS serverless)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
