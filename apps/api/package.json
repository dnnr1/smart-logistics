{
  "name": "@smart-logistics/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "esbuild src/handlers/router.ts --bundle --platform=node --target=node20 --format=cjs --external:@aws-sdk/* --outfile=dist/index.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.716.0",
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/lib-dynamodb": "^3.716.0",
    "@smart-logistics/domain": "workspace:*",
    "@smart-logistics/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "esbuild": "^0.24.2"
  }
}
