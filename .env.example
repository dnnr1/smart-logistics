# Copy to .env and fill in for local development. NEVER commit real secrets.

# --- API / AWS ---
AWS_REGION=us-east-1
# Local development uses a local DynamoDB or the real table name when deployed.
DYNAMODB_TABLE_NAME=smart-logistics-dev-deliveries

# --- Risk scoring ---
# heuristic (default) | sagemaker
RISK_SCORER=heuristic
# Optional: only used when RISK_SCORER=sagemaker
SAGEMAKER_ENDPOINT_NAME=

# --- Generative AI (Amazon Bedrock) ---
# Leave empty to disable the assistant (API returns 503 AI_UNAVAILABLE).
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-east-1

# --- Web ---
VITE_API_BASE_URL=http://localhost:3000